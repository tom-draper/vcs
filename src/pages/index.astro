---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CacheHierarchy from '../components/CacheHierarchy.astro';
import CodeCube from '../components/CodeCube.astro';
import DiskDrive from '../components/DiskDrive.astro';
import LossLandscape from '../components/LossLandscape.astro';
import { allPages, parts } from '../outline';
import { url } from '../lib/url';

const written = new Set((await getCollection('docs')).map((entry) => entry.id));
const first = allPages.find((page) => written.has(page.id));

// The 3D figures that can stand beside the title. One is picked at random on
// each visit, and the link under the title goes to the page it comes from.
const heroes = [
  {
    id: 'code-cube',
    page: 'information/error-correcting-codes',
    link: 'Explore the code cube',
    Figure: CodeCube,
    caption:
      'Every word is a corner, and every edge flips one bit. Three bits make a cube, four make a tesseract. A code picks corners far enough apart that a damaged word can find its way home.',
  },
  {
    id: 'cache-hierarchy',
    page: 'architecture/cpu-caches',
    link: 'Explore the memory hierarchy',
    Figure: CacheHierarchy,
    caption:
      'The core, three caches and main memory, each farther away and slower than the last. Every read travels out to the nearest level that holds its data, and the whole line comes back.',
  },
  {
    id: 'loss-landscape',
    page: 'machine-learning/gradient-descent',
    link: 'Explore the loss landscape',
    Figure: LossLandscape,
    caption:
      'A loss surface with one deepest valley and several shallower ones. Each ball is a training run rolling downhill, first by plain gradient descent and then with momentum.',
  },
  {
    id: 'disk-drive',
    page: 'architecture/storage-devices',
    link: 'Explore the hard disk',
    Figure: DiskDrive,
    caption:
      'A hard disk, slowed 120 times. Every read waits for the arm to reach its track, then for the sector to spin round to the head.',
  },
].filter((hero) => written.has(hero.page));
---

<Base>
  <div class="page home">
    <section class="hero">
      <div class="hero-text">
        <h1>Visual Computer Science</h1>
        <p class="byline">By Tom Draper</p>
        <p>
          Every concept gets a page, and every page has figures you can turn, push and break.
          Read it front to back like a book, or go straight to the thing you need.
        </p>
        <div class="actions">
          {first && <a class="cta" href={url(first.id)}>Start reading</a>}
          {heroes[0] && <a data-hero-link href={url(heroes[0].page)}>{heroes[0].link}</a>}
        </div>
        <p class="progress">
          {
            written.size < allPages.length
              ? `${written.size} of ${allPages.length} pages written so far. Greyed-out titles are planned.`
              : `${allPages.length} pages across ${parts.length} parts.`
          }
        </p>
      </div>
      {
        heroes.map(({ id, Figure, caption }, index) => (
          <figure class="hero-figure" data-hero={id} hidden={index > 0}>
            <Figure variant="hero" />
            <figcaption>{caption}</figcaption>
          </figure>
        ))
      }
      <script
        is:inline
        define:vars={{ choices: heroes.map(({ id, page, link }) => ({ id, href: url(page), link })) }}
      >
        // Runs while the page is parsed, before the figures load three.js, so
        // only the chosen one ever draws. Avoid repeating the last visit's pick.
        (() => {
          let last = null;
          try {
            last = localStorage.getItem('hero');
          } catch {}
          const pool = choices.length > 1 ? choices.filter((c) => c.id !== last) : choices;
          const pick = pool[Math.floor(Math.random() * pool.length)];
          if (!pick) return;
          try {
            localStorage.setItem('hero', pick.id);
          } catch {}
          document.querySelectorAll('[data-hero]').forEach((figure) => {
            figure.hidden = figure.dataset.hero !== pick.id;
          });
          const link = document.querySelector('[data-hero-link]');
          if (link) {
            link.href = pick.href;
            link.textContent = pick.link;
          }
        })();
      </script>
    </section>

    <section class="contents" aria-labelledby="contents">
      <h2 id="contents">Contents</h2>
      <p>{parts.length} parts, in reading order.</p>
      {
        parts.map((part, index) => (
          <section class="part">
            <span class="num" aria-hidden="true">{index + 1}</span>
            <h3>{part.title}</h3>
            <p class="summary">{part.summary}</p>
            <div class="chapters">
              {part.chapters.map((chapter) => (
                <div class="chapter">
                  <h4>{chapter.title}</h4>
                  <ul>
                    {chapter.pages.map((page) => (
                      <li>
                        {written.has(page.id) ? (
                          <a href={url(page.id)}>{page.title}</a>
                        ) : (
                          <span class="planned">{page.title}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</Base>
