---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
}

const {
  title,
  description = 'Visual Computer Science: a book of computer science concepts, each with figures you can turn, push and break.',
  currentId,
} = Astro.props;
const pageTitle = title ? `${title} | Visual Computer Science` : 'Visual Computer Science';
// The mark: the 3-bit cube. Each corner is a word, and each edge flips one
// bit, coloured in that bit's ink: cyan for the first, magenta for the
// second, yellow for the third.
const corner = (b: number) => [
  2.5 + 13 * (b & 1) + 6.5 * ((b >> 2) & 1),
  21.5 - 13 * ((b >> 1) & 1) - 6.5 * ((b >> 2) & 1),
];
let edges = '';
let corners = '';
for (let b = 0; b < 8; b++) {
  const [x, y] = corner(b);
  for (let k = 0; k < 3; k++) {
    if (b & (1 << k)) continue;
    const [x2, y2] = corner(b | (1 << k));
    edges += `<line class="e${k + 1}" x1="${x}" y1="${y}" x2="${x2}" y2="${y2}"/>`;
  }
  corners += `<circle class="v" cx="${x}" cy="${y}" r="2"/>`;
}
const markBody = `<g stroke-width="2" stroke-linecap="round">${edges}</g>${corners}`;
const mark = `<svg class="mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">${markBody}</svg>`;
// The favicon carries its own inks, since it cannot read the page's.
const faviconInks =
  '.e1{stroke:#0098b6}.e2{stroke:#d6246e}.e3{stroke:#e3a300}.v{fill:#18202e}' +
  '@media (prefers-color-scheme:dark){.e1{stroke:#3dd8f0}.e2{stroke:#ff5cab}.e3{stroke:#ffd54a}.v{fill:#e5e8ef}}';
const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><style>${faviconInks}</style>${markBody}</svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="en" data-base={url('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,400..700&display=swap"
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show contents" />
    <header class="masthead">
      <label for="nav-toggle" class="icon-btn menu-btn" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
      </label>
      <a class="brand" href={url('')}>
        <Fragment set:html={mark} />
        <span class="full"><span>Visual</span> <span>Computer Science</span></span>
        <span class="short">VCS</span>
      </a>
      <button id="search-btn" class="search-btn" type="button">
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
        <span>Search</span>
        <kbd>/</kbd>
      </button>
      <button id="theme-btn" class="icon-btn" type="button" aria-label="Switch between light and dark theme">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"></path></svg>
      </button>
    </header>

    <nav class="sidebar" aria-label="Contents">
      <Sidebar currentId={currentId} />
    </nav>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

    <main>
      <slot />
    </main>

    <dialog id="search" class="search-dialog" aria-label="Search">
      <div id="search-ui"></div>
      <p id="search-fallback" class="search-fallback" hidden>
        Search is built with the site. Run <code>pnpm build &amp;&amp; pnpm preview</code> to use it locally.
      </p>
    </dialog>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const base = root.dataset.base;

        document.getElementById('theme-btn').addEventListener('click', () => {
          const current =
            root.dataset.theme ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });

        // Keep the current page visible in a long sidebar.
        document
          .querySelector('.sidebar [aria-current="page"]')
          ?.scrollIntoView({ block: 'center' });

        // Pagefind is only fetched the first time search is opened.
        const dialog = document.getElementById('search');
        let loading;
        function loadSearch() {
          loading ??= new Promise((resolve, reject) => {
            const css = document.createElement('link');
            css.rel = 'stylesheet';
            css.href = base + 'pagefind/pagefind-ui.css';
            const js = document.createElement('script');
            js.src = base + 'pagefind/pagefind-ui.js';
            js.onload = resolve;
            js.onerror = reject;
            document.head.append(css, js);
          })
            .then(() => {
              new PagefindUI({
                element: '#search-ui',
                showImages: false,
                showSubResults: true,
              });
            })
            .catch(() => {
              document.getElementById('search-fallback').hidden = false;
            });
          return loading;
        }
        async function openSearch() {
          if (dialog.open) return;
          dialog.showModal();
          await loadSearch();
          dialog.querySelector('input')?.focus();
        }
        document.getElementById('search-btn').addEventListener('click', openSearch);
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });

        document.addEventListener('keydown', (event) => {
          const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName);
          if ((event.key === '/' && !typing) || (event.key === 'k' && (event.metaKey || event.ctrlKey))) {
            event.preventDefault();
            openSearch();
            return;
          }
          if (typing || dialog.open || event.metaKey || event.ctrlKey || event.altKey) return;
          const rel = { ArrowLeft: 'prev', ArrowRight: 'next' }[event.key];
          const link = rel && document.querySelector(`a[rel="${rel}"]`);
          if (link) location.href = link.href;
        });
      })();
    </script>
  </body>
</html>
