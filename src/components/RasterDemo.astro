---
// A triangle over a grid of pixels. Drag its corners and watch which pixels it
// covers, test pixels one by one with edge functions, blend colours with
// barycentric weights, multisample the edges, or settle overlaps with depth.
import { coverageCounts, raster, rasterSvg, type P2 } from '../lib/graphics';

const tri: P2[] = [
  { x: 3.2, y: 2.1 },
  { x: 15.6, y: 4.4 },
  { x: 7.4, y: 11.3 },
];
const counts = coverageCounts(tri);
const modes = [
  ['coverage', 'Coverage'],
  ['colour', 'Blend colours'],
  ['samples', '4× multisampling'],
  ['depth', 'Two triangles, depth test'],
];
---

<raster-demo class="playground raster-demo">
  <div class="viz-scroll">
    <svg class="viz-svg chart rs-chart" viewBox={`0 0 ${raster.cols * raster.cell} ${raster.rows * raster.cell}`} role="img" aria-label="A grid of pixels with a triangle drawn over it. Pixels whose centres fall inside the triangle are filled." set:html={rasterSvg(tri, 'coverage')} />
  </div>
  <p class="tries">
    {modes.map(([mode, text], i) => <button type="button" data-mode={mode} aria-pressed={i === 0 ? 'true' : 'false'}>{text}</button>)}
  </p>
  <p class="tries">
    <button type="button" data-act="scan">Scan the bounding box</button>
    <button type="button" data-act="box" aria-pressed="false">Show bounding box</button>
    <button type="button" data-act="reset">Reset</button>
  </p>
  <dl class="readouts" aria-live="polite">
    <div><dt>Pixels tested</dt><dd data-out="tested">{counts.tested}</dd></div>
    <div><dt>Pixels covered</dt><dd data-out="covered">{counts.covered}</dd></div>
    <div><dt>Triangle area</dt><dd data-out="area">{counts.area.toFixed(1)} px</dd></div>
  </dl>
  <dl class="readouts" data-out="pixel">
    <div><dt>Pixel</dt><dd data-out="where">point at a pixel</dd></div>
    <div><dt>Weights A, B, C</dt><dd data-out="weights">–</dd></div>
    <div><dt>Verdict</dt><dd data-out="verdict">–</dd></div>
  </dl>
  <p class="hint" data-out="status" aria-live="polite">Drag the corners A, B and C. A pixel is filled when the dot at its centre is inside the triangle. Point at a pixel to see its weights.</p>
</raster-demo>

<script>
  import { coverageCounts, inspectPixel, raster, rasterSvg, boundingBox, type P2, type RasterMode } from '../lib/graphics';

  const start: P2[] = [
    { x: 3.2, y: 2.1 },
    { x: 15.6, y: 4.4 },
    { x: 7.4, y: 11.3 },
  ];

  const statuses: Record<RasterMode, string> = {
    coverage:
      'Drag the corners A, B and C. A pixel is filled when the dot at its centre is inside the triangle. Point at a pixel to see its weights.',
    colour:
      'Each corner has a colour. Every covered pixel mixes the three in proportion to its weights, so the colour shifts smoothly across the face. Depth, texture coordinates and normals are blended the same way.',
    samples:
      'Four sample points per pixel instead of one centre. A pixel on the edge is shaded by the share of its samples inside, so the staircase softens into a gradient.',
    depth:
      'The orange triangle is fixed and tilted so it passes through the blue one. Each pixel keeps whichever surface is nearer at that pixel, so they cut through each other cleanly. No order of drawing whole triangles could do that.',
  };

  class RasterDemo extends HTMLElement {
    connectedCallback() {
      let tri = start.map((p) => ({ ...p }));
      let mode: RasterMode = 'coverage';
      let hover: [number, number] | null = null;
      let showBox = false;
      let upTo: number | undefined;
      let timer = 0;
      let dragging = -1;
      const svg = this.querySelector('svg')!;
      const out = (name: string) => this.querySelector(`[data-out="${name}"]`)!;
      const { cols, rows } = raster;

      const render = () => {
        svg.innerHTML = rasterSvg(tri, mode, { upTo, hover, box: showBox || upTo !== undefined });
        const counts = coverageCounts(tri);
        out('tested').textContent = String(counts.tested);
        out('covered').textContent = String(counts.covered);
        out('area').textContent = `${counts.area.toFixed(1)} px`;
        if (!hover) {
          out('where').textContent = 'point at a pixel';
          out('weights').textContent = '–';
          out('verdict').textContent = '–';
          return;
        }
        const r = inspectPixel(tri, hover[0], hover[1]);
        out('where').textContent = `(${hover[0]}, ${hover[1]}), centre at (${hover[0] + 0.5}, ${hover[1] + 0.5})`;
        out('weights').textContent = r.weights.map((w) => w.toFixed(2)).join(', ');
        if (mode === 'depth') {
          const a = r.depthA;
          const b = r.depthB;
          out('verdict').textContent =
            a === null && b === null
              ? 'no surface here'
              : a === null
                ? `only orange, depth ${b!.toFixed(2)}`
                : b === null
                  ? `only blue, depth ${a.toFixed(2)}`
                  : `blue ${a.toFixed(2)}, orange ${b.toFixed(2)}: ${a < b ? 'blue' : 'orange'} is nearer`;
        } else if (mode === 'samples') {
          out('verdict').textContent = `${r.samples} of 4 samples inside, ${r.samples * 25}% coverage`;
        } else {
          const negative = r.weights.map((w, i) => (w < 0 ? 'ABC'[(i + 1) % 3] + 'ABC'[(i + 2) % 3] : '')).filter(Boolean);
          out('verdict').textContent = r.covered ? 'inside: every weight is 0 or more' : `outside edge ${negative.join(' and ')}`;
        }
      };

      const stop = () => {
        clearInterval(timer);
        timer = 0;
        upTo = undefined;
      };

      const toGrid = (event: PointerEvent): P2 => {
        const box = svg.getBoundingClientRect();
        return {
          x: ((event.clientX - box.left) / box.width) * cols,
          y: ((event.clientY - box.top) / box.height) * rows,
        };
      };

      svg.addEventListener('pointerdown', (event) => {
        const handle = (event.target as Element).closest<SVGGElement>('[data-vertex]');
        if (!handle) return;
        dragging = Number(handle.dataset.vertex);
        svg.setPointerCapture(event.pointerId);
        stop();
        event.preventDefault();
      });

      svg.addEventListener('pointermove', (event) => {
        const p = toGrid(event);
        if (dragging >= 0) {
          tri[dragging] = { x: Math.max(0, Math.min(cols, Math.round(p.x * 10) / 10)), y: Math.max(0, Math.min(rows, Math.round(p.y * 10) / 10)) };
        }
        const next: [number, number] | null = p.x >= 0 && p.x < cols && p.y >= 0 && p.y < rows ? [Math.floor(p.x), Math.floor(p.y)] : null;
        if (dragging >= 0 || next?.[0] !== hover?.[0] || next?.[1] !== hover?.[1]) {
          hover = next;
          render();
        }
      });

      const release = () => {
        dragging = -1;
      };
      svg.addEventListener('pointerup', release);
      svg.addEventListener('pointercancel', release);
      svg.addEventListener('pointerleave', () => {
        if (dragging >= 0) return;
        hover = null;
        render();
      });

      this.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!button) return;
        if (button.dataset.mode) {
          stop();
          mode = button.dataset.mode as RasterMode;
          this.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          out('status').textContent = statuses[mode];
          render();
          return;
        }
        const act = button.dataset.act;
        if (act === 'box') {
          showBox = !showBox;
          button.setAttribute('aria-pressed', String(showBox));
          render();
        } else if (act === 'reset') {
          stop();
          tri = start.map((p) => ({ ...p }));
          hover = null;
          out('status').textContent = statuses[mode];
          render();
        } else if (act === 'scan') {
          stop();
          const box = boundingBox(tri);
          const total = (box.x1 - box.x0 + 1) * (box.y1 - box.y0 + 1);
          upTo = 0;
          out('status').textContent = 'Testing every pixel in the bounding box, row by row. For each one, three edge functions say which side of each edge its centre is on.';
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          timer = window.setInterval(() => {
            upTo! += reduced ? total : 1;
            if (upTo! >= total) {
              stop();
              const counts = coverageCounts(tri);
              out('status').textContent = `Done: ${counts.tested} pixels tested, ${counts.covered} inside. Every test is independent of the others, which is why a GPU runs thousands of them at once.`;
            }
            render();
          }, 28);
          render();
        }
      });
    }
  }

  customElements.define('raster-demo', RasterDemo);
</script>
